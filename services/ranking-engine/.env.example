# Kafka (Upstash)
KAFKA_BOOTSTRAP_SERVERS=your-upstash-broker.upstash.io:9092
KAFKA_SASL_USERNAME=your-upstash-username
KAFKA_SASL_PASSWORD=your-upstash-password
KAFKA_CONSUMER_GROUP=ranking-engine-group

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=smarthire

# Scoring weights (must sum to 1.0)
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.30
WEIGHT_EDUCATION=0.20
WEIGHT_SEMANTIC=0.10

# Embedding model (downloaded at Docker build time)
EMBEDDING_MODEL=all-MiniLM-L6-v2
