# Kafka (local Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP=interview-scheduler-group
KAFKA_TOPIC_INTERVIEW_SCHEDULED=interview.scheduled
KAFKA_TOPIC_INTERVIEW_CANCELLED=interview.cancelled
KAFKA_TOPIC_INTERVIEW_RESCHEDULED=interview.rescheduled

# MongoDB (local Docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smarthire

# Google OAuth2 — get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8092/auth/google/callback
GOOGLE_TOKEN_FILE=token.json
