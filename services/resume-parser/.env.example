# Kafka (Upstash)
KAFKA_BOOTSTRAP_SERVERS=your-upstash-broker.upstash.io:9092
KAFKA_SASL_USERNAME=your-upstash-username
KAFKA_SASL_PASSWORD=your-upstash-password
KAFKA_CONSUMER_GROUP=resume-parser-group

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=resumes

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# spaCy
SPACY_MODEL=en_core_web_sm
