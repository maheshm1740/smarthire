# ── PostgreSQL (local Docker) ─────────────────────────────────────────
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
JOB_DB_URL=jdbc:postgresql://localhost:5432/job_db
DB_USERNAME=smarthire
DB_PASSWORD=smarthire123

# ── MongoDB (local Docker) ────────────────────────────────────────────
MONGO_URI=mongodb://smarthire:smarthire123@localhost:27017/smarthire?authSource=admin

# ── Redis (local Docker) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=smarthire123

# ── Kafka (local Docker) ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# ── MinIO / S3 file storage (local Docker) ───────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=smarthire
MINIO_SECRET_KEY=smarthire123
MINIO_BUCKET=smarthire-resumes

# ── JWT (RS256) ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem
#   base64 -w 0 public.pem
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_PUBLIC_KEY
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Anthropic (Claude API) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── SendGrid ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_ME
SENDGRID_FROM_EMAIL=noreply@smarthire.dev

# ── Google Calendar OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME

# ── Service URLs (internal, for Gateway routing) ──────────────────────
AUTH_SERVICE_URL=http://localhost:8081
JOB_SERVICE_URL=http://localhost:8082
CANDIDATE_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
RESUME_PARSER_URL=http://localhost:8090
RANKING_ENGINE_URL=http://localhost:8091
INTERVIEW_SCHEDULER_URL=http://localhost:8092
JD_GENERATOR_URL=http://localhost:8093
